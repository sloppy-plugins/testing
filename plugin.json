{
  "manifest_version": 1,
  "protocol_version": 1,
  "actions": {
    "provider_key": "default",
    "catalog": {
      "actions_version": 1,
      "actions": [
        {
          "key": "show_message",
          "title": "Show test message",
          "description": "Immediately show an informational bubble.",
          "input_schema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "interaction": "immediate",
          "timeout_ms": 60000,
          "category": "immediate"
        },
        {
          "key": "increment_counter",
          "title": "Increment test counter",
          "description": "Immediately increment an in-memory counter; see its value in the testing TUI.",
          "input_schema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "interaction": "immediate",
          "timeout_ms": 60000,
          "category": "immediate"
        },
        {
          "key": "greet",
          "title": "Greet someone…",
          "description": "Ask for a name, then display the greeting after Send.",
          "input_schema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "interaction": "input_bubble",
          "timeout_ms": 300000,
          "prompt": {
            "type": "questionnaire",
            "parameters": {
              "questions": [
                {
                  "id": "name",
                  "title": "Name",
                  "required": true,
                  "response": {
                    "value_type": "text",
                    "allow_custom": true,
                    "choices": []
                  }
                }
              ]
            }
          },
          "category": "with_input"
        },
        {
          "key": "add_numbers",
          "title": "Add two numbers…",
          "description": "Ask for two numbers, then display their sum after Send.",
          "input_schema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "interaction": "input_bubble",
          "timeout_ms": 300000,
          "prompt": {
            "type": "questionnaire",
            "parameters": {
              "questions": [
                {
                  "id": "first",
                  "title": "First number",
                  "required": true,
                  "response": {
                    "value_type": "number",
                    "allow_custom": true,
                    "choices": [],
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                },
                {
                  "id": "second",
                  "title": "Second number",
                  "required": true,
                  "response": {
                    "value_type": "number",
                    "allow_custom": true,
                    "choices": [],
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                }
              ]
            }
          },
          "category": "with_input"
        }
      ],
      "menus": [],
      "categories": [
        {
          "key": "immediate",
          "title": "Immediate",
          "description": "Actions that run without requesting input."
        },
        {
          "key": "with_input",
          "title": "With input",
          "description": "Actions that collect answers in a bubble."
        }
      ]
    }
  },
  "plugin": {
    "id": "testing",
    "name": "Bubble Testing",
    "version": "0.1.3",
    "description": "An independent bubble workbench with immediate and input-driven testing actions.",
    "layouts": {
      "default": {
        "template": "card",
        "accent": "automatic",
        "width": 430,
        "show_details": false,
        "input_placeholder": "Enter a test response..."
      }
    },
    "icon": "data:image/png;base64,"
  },
  "runtime": {
    "kind": "process",
    "executables": {
      "macos-aarch64": "testing.py",
      "macos-x86_64": "testing.py",
      "linux-aarch64": "testing.py",
      "linux-x86_64": "testing.py",
      "windows-x86_64": "testing.cmd"
    }
  },
  "dependencies": [
    {
      "runtime": "python",
      "minimum_version": "3.11"
    }
  ],
  "initialization": [
    {
      "kind": "python_venv",
      "directory": ".venv",
      "requirements": "requirements.txt"
    }
  ],
  "background": {
    "arguments": [
      "--actions"
    ]
  }
}
